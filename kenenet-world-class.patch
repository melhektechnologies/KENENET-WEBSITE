diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..e6c2261
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,12 @@
+# ── Consultation form delivery (required for the form to send) ─────────────
+# Until all three are set, the form shows a failure message. It never fakes success.
+RESEND_API_KEY=
+CONSULTATION_TO_EMAIL=          # comma-separated inboxes, client to confirm (E-15)
+CONSULTATION_FROM_EMAIL=        # e.g. "Kenenét Consultancy <noreply@your-verified-domain>"
+
+# ── Domain (set once confirmed, E-07). Falls back to the Vercel production URL.
+NEXT_PUBLIC_SITE_URL=
+
+# ── Unverified-content gate ────────────────────────────────────────────────
+# Draft/unverified blocks are hidden on production and shown on previews.
+# Force-show on production (NOT recommended): SHOW_DRAFT_CONTENT=true
diff --git a/next.config.mjs b/next.config.mjs
new file mode 100644
index 0000000..ba5dce0
--- /dev/null
+++ b/next.config.mjs
@@ -0,0 +1,18 @@
+/** @type {import('next').NextConfig} */
+const securityHeaders = [
+  { key: "X-Content-Type-Options", value: "nosniff" },
+  { key: "X-Frame-Options", value: "DENY" },
+  { key: "Referrer-Policy", value: "strict-origin-when-cross-origin" },
+  { key: "Permissions-Policy", value: "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()" },
+  { key: "Cross-Origin-Opener-Policy", value: "same-origin" },
+];
+
+const nextConfig = {
+  poweredByHeader: false,
+  reactStrictMode: true,
+  async headers() {
+    return [{ source: "/:path*", headers: securityHeaders }];
+  },
+};
+
+export default nextConfig;
