diff --git a/src/lib/content-status.ts b/src/lib/content-status.ts
new file mode 100644
index 0000000..6b2f5bd
--- /dev/null
+++ b/src/lib/content-status.ts
@@ -0,0 +1,16 @@
+import { isProduction } from "./site-url";
+
+/**
+ * Content-verification gate.
+ *
+ * Anything not yet verified against a client source document is wrapped in
+ * <Draft> or <ContentSlot>. Those render on previews and local dev (clearly
+ * marked) so the client can review, and are HIDDEN on the live production
+ * deployment, so unverified claims can never reach the public.
+ *
+ * Override (not recommended): SHOW_DRAFT_CONTENT=true
+ */
+export function showDrafts(): boolean {
+  if (process.env.SHOW_DRAFT_CONTENT === "true") return true;
+  return !isProduction();
+}
diff --git a/src/lib/site-url.ts b/src/lib/site-url.ts
new file mode 100644
index 0000000..3aa69ac
--- /dev/null
+++ b/src/lib/site-url.ts
@@ -0,0 +1,20 @@
+/**
+ * Canonical site URL.
+ * Priority: NEXT_PUBLIC_SITE_URL (set once the real domain is confirmed, E-07)
+ *           → Vercel production URL → local dev.
+ * No domain is hard-coded: the real domain is still unconfirmed.
+ */
+export function getSiteUrl(): { url: string; isConfigured: boolean } {
+  const explicit = process.env.NEXT_PUBLIC_SITE_URL?.trim();
+  if (explicit) return { url: explicit.replace(/\/$/, ""), isConfigured: true };
+
+  const vercel = process.env.VERCEL_PROJECT_PRODUCTION_URL?.trim();
+  if (vercel) return { url: `https://${vercel}`, isConfigured: true };
+
+  return { url: "http://localhost:3000", isConfigured: false };
+}
+
+/** True only for the live production deployment. */
+export function isProduction(): boolean {
+  return process.env.VERCEL_ENV === "production";
+}
