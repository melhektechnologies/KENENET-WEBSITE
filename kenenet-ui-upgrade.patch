@@ -136,6 +153,34 @@ body {
     radial-gradient(circle at 90% 80%, rgba(249, 162, 27, 0.02)  0%, transparent 35%);
 }
 
+/* ─── Hero field: layered, restrained brand light ───────────────────────── */
+.bg-hero-field {
+  background-image:
+    radial-gradient(58% 52% at 90% 6%,  rgba(127, 50, 147, 0.11) 0%, rgba(127, 50, 147, 0) 70%),
+    radial-gradient(42% 42% at 4% 98%,  rgba(249, 162, 27, 0.09) 0%, rgba(249, 162, 27, 0) 70%),
+    linear-gradient(180deg, rgba(245, 242, 247, 0) 62%, rgba(245, 242, 247, 0.75) 100%);
+}
+
+/* ─── Frosted panel (light-mode glass) ──────────────────────────────────── */
+.glass-panel {
+  background-color: rgba(255, 255, 255, 0.92);
+  border: 1px solid rgba(127, 50, 147, 0.14);
+}
+@supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
+  .glass-panel {
+    background-color: rgba(255, 255, 255, 0.62);
+    -webkit-backdrop-filter: blur(20px) saturate(140%);
+    backdrop-filter: blur(20px) saturate(140%);
+  }
+}
+@media (prefers-reduced-transparency: reduce) {
+  .glass-panel {
+    background-color: #ffffff;
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+}
+
 /* ─── Design-system colour utilities (used by layout & Tailwind classes) ── */
 .bg-paper  { background-color: var(--color-paper); }
 .text-ink  { color: var(--color-ink); }
